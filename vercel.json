{
  "redirects": [
    { "source": "/cryptoTracker", "destination": "https://cryptotracker.abhimanyu.fyi/dashboard", "permanent": true },
    { "source": "/cryptoTracker/", "destination": "https://cryptotracker.abhimanyu.fyi/dashboard", "permanent": true },
